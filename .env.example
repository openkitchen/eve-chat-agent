# Required for the self-hosted agent to call an OpenAI-compatible API.
OPENAI_BASE_URL=https://your-openai-compatible-provider.example/v1
OPENAI_API_KEY=

# Set this to a model available from the configured provider.
OPENAI_MODEL=gpt-5.4-mini

# Use "chat" for Chat Completions-compatible providers such as DeepSeek.
# Use "responses" only when the provider supports the OpenAI Responses API.
OPENAI_API_MODE=responses

# Phoenix local trace UI. It receives full model inputs and outputs.
PHOENIX_ENABLED=true
PHOENIX_COLLECTOR_ENDPOINT=http://127.0.0.1:6006/v1/traces
PHOENIX_PROJECT_NAME=eve-chat-agent
