{
  "name": "eve-chat-agent",
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "dev:log": "mkdir -p logs && next dev 2>&1 | tee -a logs/dev.log",
    "dev:phoenix": "scripts/phoenix.sh",
    "start": "next start",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:eve": "eve build",
    "dev:eve": "npm run setup:microsandbox && eve dev",
    "start:eve": "npm run setup:microsandbox && eve start",
    "setup:microsandbox": "node scripts/setup-microsandbox.mjs",
    "fixtures:file-artifacts": "node scripts/create-file-artifacts-fixtures.mjs",
    "test:file-artifacts": "vitest run lib/file-artifacts/core.test.ts agent/lib/file-artifacts-state.test.ts app/_components/file-artifact-renderer.test.tsx",
    "test:microsandbox": "vitest run agent/lib/microsandbox.test.ts",
    "test:session-runtime-ui": "vitest run lib/local-diagnostics.test.ts app/_components/local-diagnostics-controls.test.tsx"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.16",
    "@ai-sdk/otel": "^1.0.31",
    "@arizeai/openinference-semantic-conventions": "^2.5.0",
    "@arizeai/openinference-vercel": "^3.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.220.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-trace-node": "^2.9.0",
    "@radix-ui/react-use-controllable-state": "1.2.2",
    "@shikijs/core": "4.1.0",
    "@shikijs/engine-javascript": "4.1.0",
    "@shikijs/engine-oniguruma": "4.1.0",
    "@streamdown/cjk": "1.0.3",
    "@streamdown/code": "1.1.1",
    "@streamdown/math": "1.0.2",
    "@streamdown/mermaid": "1.0.2",
    "@tailwindcss/postcss": "4.3.0",
    "@vercel/connect": "0.2.2",
    "ai": "^7.0.26",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "csv-parse": "^7.0.1",
    "eve": "^0.24.6",
    "exceljs": "^4.4.0",
    "lucide-react": "1.16.0",
    "microsandbox": "0.6.6",
    "motion": "12.40.0",
    "nanoid": "5.1.11",
    "next": "16.3.0-preview.6",
    "radix-ui": "1.4.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "^3.9.2",
    "shiki": "4.1.0",
    "streamdown": "2.5.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.0",
    "use-stick-to-bottom": "1.1.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "24.x",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "jsdom": "^29.1.1",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "ai": "^7.0.26"
  },
  "engines": {
    "node": "24.x"
  }
}
